rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Profile ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'totalIncome', 'currency', 'updatedAt'])
      );

      function isValidUser(data) {
        return data.keys().hasAll(['email', 'updatedAt']) &&
               data.email is string && data.email.size() <= 100 &&
               data.updatedAt == request.time &&
               (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
               (data.get('totalIncome', 0) is number && data.get('totalIncome', 0) >= 0) &&
               (data.get('currency', 'USD') is string && data.get('currency', 'USD').size() <= 3);
      }
    }

    // --- Expenses ---
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidExpense(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidExpense(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'category', 'date', 'description', 'updatedAt'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidExpense(data) {
        return data.keys().hasAll(['amount', 'category', 'date', 'userId', 'createdAt']) &&
               data.amount is number && data.amount != 0 &&
               data.category is string && data.category.size() <= 50 &&
               data.date is timestamp &&
               data.userId == request.auth.uid &&
               data.createdAt == request.time &&
               (data.get('description', '') is string && data.get('description', '').size() <= 500);
      }
    }

    // --- Budgets ---
    match /budgets/{budgetId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBudget(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidBudget(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['limit', 'category', 'period', 'updatedAt'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidBudget(data) {
        return data.keys().hasAll(['category', 'limit', 'userId', 'updatedAt']) &&
               data.category is string && data.category.size() <= 50 &&
               data.limit is number && data.limit >= 0 &&
               data.userId == request.auth.uid &&
               data.updatedAt == request.time;
      }
    }
  }
}
