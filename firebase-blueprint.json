{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User's financial profile and settings",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "totalIncome": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Expense": {
      "title": "Expense Entry",
      "description": "A single expense transaction",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "category", "date", "userId"]
    },
    "Budget": {
      "title": "Budget Tracking",
      "description": "Budget limits for specific categories",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "limit": { "type": "number" },
        "period": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "limit", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of all expenses"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User defined budgets"
    }
  }
}
